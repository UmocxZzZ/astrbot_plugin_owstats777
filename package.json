{
  "name": "astrbot-plugin-owstats777-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm run typecheck && esbuild web-src/dashen-auth/app.ts --bundle --format=esm --target=es2022 --minify --charset=utf8 --legal-comments=inline --outfile=pages/dashen-auth/app.js",
    "typecheck": "tsc -p tsconfig.dashen-auth.json --noEmit",
    "check": "pnpm run build && node --check pages/dashen-auth/app.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
